cabal-version:      2.4
name:               stapill-hiss
version:            0.1.0.0
synopsis:           JSON-line simulator for the maryodel Dr. Mario model
license:            BSD-3-Clause
build-type:         Simple

executable stapill-hiss
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  ghc-options:         -Wall -O2
  build-depends:
      aeson >= 2.0 && < 2.3
    , base >= 4.10 && < 4.17
    , bytestring >= 0.10 && < 0.12
    , containers >= 0.5 && < 0.7
    , maryodel
    , unordered-containers >= 0.2 && < 0.3
    , vector >= 0.12 && < 0.14
